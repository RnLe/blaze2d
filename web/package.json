{
  "name": "blaze2d-website",
  "private": true,
  "version": "0.1.0",
  "description": "Blaze 2D - A lightweight 2D Maxwell solver for photonic band structures",
  "author": "Rene-Marcel Lehner",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm prepare:site && next build",
    "build:local": "NEXT_BASE_PATH= pnpm build",
    "preview": "pnpm run build:local && pnpm run serve:out",
    "build:band-data": "node scripts/generate-band-data.js",
    "build:changelog": "node scripts/build-changelog.js",
    "build:runs-manifest": "node scripts/generate-runs-manifest.js",
    "build:wasm": "node scripts/build-wasm.mjs",
    "deploy": "pnpm run build",
    "dev": "pnpm prepare:site && next dev",
    "go": "pnpm run build:local && pnpm run serve:out",
    "serve:out": "serve out -l 3001",
    "start": "next start",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "generate:contract": "node scripts/generate-contract.mjs",
    "generate:examples": "node scripts/generate-examples.mjs",
    "generate:posts": "node scripts/generate-posts.mjs",
    "prepare:site": "pnpm generate:contract && pnpm generate:examples && pnpm generate:posts && pnpm build:wasm",
    "test:browser": "playwright test"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@embedpdf/react-pdf-viewer": "2.14.4",
    "@lezer/highlight": "^1.2.3",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "15.5.25",
    "@react-spring/konva": "^10.0.0",
    "@react-spring/web": "^10.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.9",
    "@tanstack/react-query": "^5.0.0",
    "@visx/axis": "^3.10.1",
    "@visx/curve": "^3.3.0",
    "@visx/grid": "^3.5.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.5.0",
    "@visx/shape": "^3.5.0",
    "@visx/text": "^3.12.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fflate": "0.8.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.0",
    "konva": "^9.3.20",
    "lucide-react": "^0.511.0",
    "motion": "^12.15.0",
    "nanoid": "^5.0.0",
    "next": "15.5.25",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.0",
    "nextra": "^4.2.17",
    "nextra-theme-docs": "^4.2.17",
    "pagefind": "^1.3.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0",
    "postcss": "^8.4.0",
    "react": "19.2.8",
    "react-calendar-heatmap": "^1.10.0",
    "react-colorful": "^5.0.0",
    "react-dom": "19.2.8",
    "react-konva": "^19.0.3",
    "react-syntax-highlighter": "^15.0.0",
    "react-tooltip": "^5.28.1",
    "rehype-katex": "7.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.7.1",
    "swr": "^2.3.3",
    "tailwindcss": "^4.0.0",
    "use-sync-external-store": "^1.2.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.2",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19.1.3",
    "@types/react-syntax-highlighter": "^15.0.0",
    "@types/semver": "^7.7.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "json-schema-to-typescript": "16.0.0",
    "serve": "^14.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
