{
  "name": "blaze2d-website",
  "private": true,
  "version": "0.1.0",
  "description": "Blaze 2D - A lightweight 2D Maxwell solver for photonic band structures",
  "author": "Rene-Marcel Lehner",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm prepare:site && next build",
    "build:epsilon-grids": "node scripts/generate-epsilon-grids.js",
    "build:local": "NEXT_BASE_PATH= pnpm build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "deploy": "pnpm run build",
    "dev": "pnpm prepare:site && NEXT_BASE_PATH= node scripts/dev.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "generate:contract": "node scripts/generate-contract.mjs",
    "generate:examples": "node scripts/generate-examples.mjs",
    "go": "pnpm run build:local && pnpm run serve:out",
    "lint": "eslint .",
    "prepare:site": "pnpm generate:contract && pnpm build:wasm && pnpm generate:examples && pnpm generate:content",
    "preview": "pnpm run build:local && pnpm run serve:out",
    "serve:out": "serve out -l 3001",
    "serve:test": "NEXT_BASE_PATH= PORT=3211 node scripts/serve-export.mjs",
    "start": "next start",
    "test:browser": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:quick": "BLAZE_TEST_URL=http://127.0.0.1:3211 playwright test --project=chromium tests/reflow.spec.ts tests/site.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@embedpdf/react-pdf-viewer": "2.15.1",
    "@lezer/highlight": "^1.2.3",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "16.3.5",
    "@visx/axis": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/text": "^4.0.0",
    "fflate": "0.8.3",
    "github-slugger": "2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "mdast-util-to-string": "4.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "7.0.1",
    "rehype-pretty-code": "0.14.5",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "shiki": "4.4.3",
    "swr": "^2.5.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "json-schema-to-typescript": "16.0.0",
    "serve": "^14.2.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
