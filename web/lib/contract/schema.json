{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserContract",
  "type": "object",
  "properties": {
    "config": {
      "$ref": "#/$defs/Config"
    },
    "event": {
      "$ref": "#/$defs/Event"
    },
    "job": {
      "$ref": "#/$defs/PlannedJob"
    },
    "result": {
      "$ref": "#/$defs/ResultRecord"
    },
    "validation": {
      "$ref": "#/$defs/ValidationReport"
    }
  },
  "required": [
    "config",
    "validation",
    "result",
    "event",
    "job"
  ],
  "$defs": {
    "Array": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dtype": {
          "$ref": "#/$defs/DType"
        },
        "order": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "dtype",
        "shape",
        "dimensions",
        "order",
        "data"
      ]
    },
    "BandAccuracy": {
      "description": "Acceptance is separate from eigenvalue-change stopping. Every mode must\nmeet either residual bound, and the whole block must be B-orthonormal.\nThe absolute branch remains meaningful for zero and near-zero Gamma modes.",
      "type": "object",
      "properties": {
        "max_absolute_residual": {
          "description": "In inverse reference-length squared units, not normalized frequency.",
          "type": "number",
          "format": "double",
          "default": 1e-7
        },
        "max_orthogonality_defect": {
          "type": "number",
          "format": "double",
          "default": 1e-8
        },
        "max_relative_residual": {
          "type": "number",
          "format": "double",
          "default": 0.00001
        }
      },
      "additionalProperties": false
    },
    "BandPoint": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "number",
          "format": "double"
        },
        "frequencies": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "k_point": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "frequencies",
        "k_point",
        "distance"
      ]
    },
    "Bands": {
      "type": "object",
      "properties": {
        "accuracy": {
          "description": "Optional acceptance gate on the final physical eigenpairs.",
          "anyOf": [
            {
              "$ref": "#/$defs/BandAccuracy"
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "type": "integer",
          "format": "uint",
          "default": 8,
          "minimum": 0
        },
        "discretization": {
          "description": "Selecting a metric ball changes the finite numerical pencil.",
          "$ref": "#/$defs/Discretization"
        },
        "path": {
          "$ref": "#/$defs/KPath",
          "default": {
            "basis": "reciprocal_fractional",
            "intervals_per_segment": 15
          }
        },
        "symmetry": {
          "$ref": "#/$defs/Symmetry",
          "default": {
            "max_cache_bytes": 67108864,
            "max_continuation_bytes": 67108864,
            "max_traversal_field_bytes": 67108864
          }
        },
        "tracking": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "checkpoint_resume": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "external_inputs": {
          "type": "boolean"
        },
        "geometries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectKind"
          }
        },
        "k_stencil": {
          "type": "boolean"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "precisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Precision"
          }
        },
        "registry": {
          "type": "boolean"
        },
        "schema": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "version",
        "platform",
        "dimensions",
        "tasks",
        "precisions",
        "geometries",
        "registry",
        "k_stencil",
        "external_inputs",
        "checkpoint_resume"
      ]
    },
    "CoarseStart": {
      "type": "object",
      "properties": {
        "max_seed_field_bytes": {
          "description": "Coarse, lifted and prepared seed fields; solver and FFT scratch are extra.",
          "type": "integer",
          "format": "uint",
          "default": 67108864,
          "minimum": 0
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "resolution"
      ]
    },
    "Config": {
      "type": "object",
      "properties": {
        "bands": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bands"
            },
            {
              "type": "null"
            }
          ]
        },
        "dielectric": {
          "$ref": "#/$defs/Dielectric",
          "default": {
            "interface_tolerance": 0.000001,
            "mesh_size": 3,
            "smoothing": "analytic",
            "source": "geometry"
          }
        },
        "dimension": {
          "type": "integer",
          "format": "uint",
          "default": 2,
          "minimum": 0
        },
        "eigensolver": {
          "$ref": "#/$defs/Eigensolver",
          "default": {
            "block_size": 0,
            "history": "ritz",
            "precision": "f64",
            "preconditioner": {
              "band_window_blend": 0.5,
              "band_window_scale": 0.5,
              "coarse_modes": 0,
              "coarse_shift": 0,
              "kind": "auto",
              "profile": "auto",
              "shift": "continuous",
              "shift_value": 0,
              "tm_mass_fraction": 0.01,
              "transverse_weight": "tensor"
            },
            "stopping": "auto"
          }
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "grid": {
          "$ref": "#/$defs/Grid",
          "default": {
            "resolution": 32
          }
        },
        "operators": {
          "anyOf": [
            {
              "$ref": "#/$defs/Operators"
            },
            {
              "type": "null"
            }
          ]
        },
        "polarization": {
          "$ref": "#/$defs/Polarization",
          "default": "TM"
        },
        "results": {
          "$ref": "#/$defs/Results",
          "default": {
            "eigenvectors": false
          }
        },
        "schema": {
          "type": "string"
        },
        "sweeps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sweep"
          }
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "task",
        "geometry"
      ]
    },
    "ContinuationPolicy": {
      "type": "string",
      "enum": [
        "off",
        "first_point",
        "previous_geometry"
      ]
    },
    "DType": {
      "type": "string",
      "enum": [
        "float64",
        "complex128"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "span": {
          "description": "Half-open UTF-8 byte offsets in the original TOML document.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "Dielectric": {
      "type": "object",
      "properties": {
        "interface_tolerance": {
          "type": "number",
          "format": "double",
          "default": 0.000001
        },
        "mesh_size": {
          "type": "integer",
          "format": "uint",
          "default": 3,
          "minimum": 0
        },
        "smoothing": {
          "$ref": "#/$defs/Smoothing",
          "default": "analytic"
        },
        "source": {
          "$ref": "#/$defs/DielectricSource",
          "default": "geometry"
        }
      },
      "additionalProperties": false
    },
    "DielectricSource": {
      "type": "string",
      "enum": [
        "geometry",
        "external"
      ]
    },
    "Discretization": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fft_rectangle"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "angular_cutoff": {
              "description": "Cartesian angular cutoff in inverse reference length; no implicit 2*pi.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "metric_ball"
            },
            "max_allocation_rounds": {
              "type": "integer",
              "format": "uint",
              "default": 32,
              "minimum": 0
            },
            "max_coefficients": {
              "type": "integer",
              "format": "uint",
              "default": 4096,
              "minimum": 0
            },
            "max_dense_dimension": {
              "type": "integer",
              "format": "uint",
              "default": 512,
              "minimum": 0
            },
            "max_embedding_points": {
              "type": "integer",
              "format": "uint",
              "default": 1048576,
              "minimum": 0
            },
            "max_enumerated_indices": {
              "type": "integer",
              "format": "uint",
              "default": 4194304,
              "minimum": 0
            },
            "max_estimated_payload_bytes": {
              "description": "Numerical payload admission, not a process RSS limit.",
              "type": "integer",
              "format": "uint",
              "default": 536870912,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "angular_cutoff"
          ]
        }
      ]
    },
    "Eigensolver": {
      "type": "object",
      "properties": {
        "block_size": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "history": {
          "$ref": "#/$defs/History",
          "default": "ritz"
        },
        "max_iterations": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "precision": {
          "$ref": "#/$defs/Precision",
          "default": "f64"
        },
        "preconditioner": {
          "$ref": "#/$defs/Preconditioner",
          "default": {
            "band_window_blend": 0.5,
            "band_window_scale": 0.5,
            "coarse_modes": 0,
            "coarse_shift": 0,
            "kind": "auto",
            "profile": "auto",
            "shift": "continuous",
            "shift_value": 0,
            "tm_mass_fraction": 0.01,
            "transverse_weight": "tensor"
          }
        },
        "residual_tolerance": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "stopping": {
          "$ref": "#/$defs/Stopping",
          "default": "auto"
        },
        "tolerance": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "run_start"
            },
            "jobs": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "solves": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "event",
            "jobs",
            "solves"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "job_start"
            },
            "job": {
              "$ref": "#/$defs/PlannedJob"
            },
            "job_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "event",
            "job_index",
            "job"
          ]
        },
        {
          "type": "object",
          "properties": {
            "band_point": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BandPoint"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completed": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "converged": {
              "type": "boolean"
            },
            "event": {
              "type": "string",
              "const": "progress"
            },
            "iterations": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "job_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "sample_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "event",
            "job_index",
            "sample_index",
            "completed",
            "total",
            "iterations",
            "converged"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "result"
            },
            "result": {
              "$ref": "#/$defs/ResultRecord"
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/JobFailure"
            },
            "event": {
              "type": "string",
              "const": "job_failure"
            }
          },
          "required": [
            "event",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "completed": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "event": {
              "type": "string",
              "const": "terminal"
            },
            "failed": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "status": {
              "$ref": "#/$defs/RunStatus"
            }
          },
          "required": [
            "event",
            "status",
            "completed",
            "failed"
          ]
        }
      ]
    },
    "Geometry": {
      "type": "object",
      "properties": {
        "background_epsilon": {
          "type": "number",
          "format": "double",
          "default": 1
        },
        "lattice": {
          "$ref": "#/$defs/Lattice"
        },
        "objects": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Object"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "lattice"
      ]
    },
    "Grid": {
      "type": "object",
      "properties": {
        "resolution": {
          "$ref": "#/$defs/Resolution",
          "default": 32
        }
      },
      "additionalProperties": false
    },
    "History": {
      "description": "Third LOBPCG search block: next Ritz vectors, conjugate directions, or none.",
      "type": "string",
      "enum": [
        "ritz",
        "conjugate",
        "none"
      ]
    },
    "JobFailure": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "$ref": "#/$defs/Diagnostic"
        },
        "job_index": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "partial_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultRecord"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_index",
        "diagnostic"
      ]
    },
    "KCoordinates": {
      "type": "string",
      "enum": [
        "reciprocal_fractional",
        "cartesian_angular"
      ]
    },
    "KPath": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/KCoordinates",
          "default": "reciprocal_fractional"
        },
        "intervals_per_segment": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "points": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "vertices": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "KPoint": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/KCoordinates"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "basis"
      ]
    },
    "KReuse": {
      "type": "string",
      "enum": [
        "off",
        "identical",
        "unitary",
        "time_reversal"
      ]
    },
    "KStencil": {
      "type": "object",
      "properties": {
        "half_width": {
          "type": "number",
          "format": "double"
        },
        "points_per_axis": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "points_per_axis",
        "half_width"
      ]
    },
    "KTraversal": {
      "type": "string",
      "enum": [
        "given",
        "nearest"
      ]
    },
    "Lattice": {
      "type": "object",
      "properties": {
        "a": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "angle_deg": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "b": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "type": {
          "$ref": "#/$defs/LatticeKind"
        },
        "vectors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LatticeKind": {
      "type": "string",
      "enum": [
        "square",
        "triangular",
        "rectangular",
        "oblique",
        "custom"
      ]
    },
    "Linspace": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "number",
          "format": "double"
        },
        "stop": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "stop",
        "count"
      ]
    },
    "Object": {
      "type": "object",
      "properties": {
        "center": {
          "type": "array",
          "default": [
            0,
            0
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "epsilon": {
          "type": "number",
          "format": "double"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind"
        },
        "name": {
          "type": "string"
        },
        "radius": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "radius",
        "epsilon"
      ]
    },
    "ObjectKind": {
      "type": "string",
      "enum": [
        "circle"
      ]
    },
    "Operators": {
      "type": "object",
      "properties": {
        "band_lo": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "fail_on_residual": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "k_point": {
          "$ref": "#/$defs/KPoint"
        },
        "k_stencil": {
          "anyOf": [
            {
              "$ref": "#/$defs/KStencil"
            },
            {
              "type": "null"
            }
          ]
        },
        "quantities": {
          "type": "array",
          "default": [
            "velocity",
            "mass_tensor"
          ],
          "items": {
            "$ref": "#/$defs/Quantity"
          }
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "registry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Registry"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_bands": {
          "type": "integer",
          "format": "uint",
          "default": 8,
          "minimum": 0
