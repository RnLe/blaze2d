{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserContract",
  "type": "object",
  "properties": {
    "config": {
      "$ref": "#/$defs/Config"
    },
    "event": {
      "$ref": "#/$defs/Event"
    },
    "job": {
      "$ref": "#/$defs/PlannedJob"
    },
    "result": {
      "$ref": "#/$defs/ResultRecord"
    },
    "validation": {
      "$ref": "#/$defs/ValidationReport"
    }
  },
  "required": [
    "config",
    "validation",
    "result",
    "event",
    "job"
  ],
  "$defs": {
    "Array": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dtype": {
          "$ref": "#/$defs/DType"
        },
        "order": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "dtype",
        "shape",
        "dimensions",
        "order",
        "data"
      ]
    },
    "BandAccuracy": {
      "description": "Acceptance is separate from eigenvalue-change stopping. Every mode must\nmeet either residual bound, and the whole block must be B-orthonormal.\nThe absolute branch remains meaningful for zero and near-zero Gamma modes.",
      "type": "object",
      "properties": {
        "max_absolute_residual": {
          "description": "In inverse reference-length squared units, not normalized frequency.",
          "type": "number",
          "format": "double",
          "default": 1e-7
        },
        "max_orthogonality_defect": {
          "type": "number",
          "format": "double",
          "default": 1e-8
        },
        "max_relative_residual": {
          "type": "number",
          "format": "double",
          "default": 0.00001
        }
      },
      "additionalProperties": false
    },
    "BandPoint": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "number",
          "format": "double"
        },
        "frequencies": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "k_point": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "frequencies",
        "k_point",
        "distance"
      ]
    },
    "Bands": {
      "type": "object",
      "properties": {
        "accuracy": {
          "description": "Optional acceptance gate on the final physical eigenpairs.",
          "anyOf": [
            {
              "$ref": "#/$defs/BandAccuracy"
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "type": "integer",
          "format": "uint",
          "default": 8,
          "minimum": 0
        },
        "discretization": {
          "description": "Selecting a metric ball changes the finite numerical pencil.",
          "$ref": "#/$defs/Discretization"
        },
        "operator_diagnostics": {
          "description": "Optional setup probes; ordinary solves do not compute condition estimates.",
          "type": "boolean"
        },
        "path": {
          "$ref": "#/$defs/KPath",
          "default": {
            "basis": "reciprocal_fractional",
            "intervals_per_segment": 15
          }
        },
        "symmetry": {
          "$ref": "#/$defs/Symmetry",
          "default": {
            "arithmetic": "spatial_complex",
            "continuation": "off",
            "correction_projection_interval": 1,
            "k_reuse": "off",
            "k_traversal": "given",
            "max_cache_bytes": 67108864,
            "max_continuation_bytes": 67108864,
            "max_traversal_field_bytes": 67108864,
            "policy": "manual",
            "reconstruct_partners": false,
            "sector_kernel": "full_grid",
            "sector_storage": "full_grid",
            "sectors": "off",
            "seed_transfer": "copy",
            "share_sector_workspace": false
          }
        },
        "tracking": {
          "type": "boolean",
          "default": true
        },
        "warm_start": {
          "description": "Native parameter continuation. Omitted by default.",
          "anyOf": [
            {
              "$ref": "#/$defs/GeometryWarmStart"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "checkpoint_resume": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "external_inputs": {
          "type": "boolean"
        },
        "geometries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectKind"
          }
        },
        "k_stencil": {
          "type": "boolean"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "precisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Precision"
          }
        },
        "registry": {
          "type": "boolean"
        },
        "schema": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "version",
        "platform",
        "dimensions",
        "tasks",
        "precisions",
        "geometries",
        "registry",
        "k_stencil",
        "external_inputs",
        "checkpoint_resume"
      ]
    },
    "CoarseStart": {
      "type": "object",
      "properties": {
        "max_seed_field_bytes": {
          "description": "Coarse, lifted and prepared seed fields; solver and FFT scratch are extra.",
          "type": "integer",
          "format": "uint",
          "default": 67108864,
          "minimum": 0
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "resolution"
      ]
    },
    "Config": {
      "type": "object",
      "properties": {
        "bands": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bands"
            },
            {
              "type": "null"
            }
          ]
        },
        "dielectric": {
          "$ref": "#/$defs/Dielectric",
          "default": {
            "interface_tolerance": 0.000001,
            "mesh_size": 3,
            "smoothing": "analytic",
            "source": "geometry"
          }
        },
        "dimension": {
          "type": "integer",
          "format": "uint",
          "default": 2,
          "minimum": 0
        },
        "eigensolver": {
          "$ref": "#/$defs/Eigensolver",
          "default": {
            "block_size": 0,
            "precision": "f64"
          }
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "grid": {
          "$ref": "#/$defs/Grid",
          "default": {
            "resolution": 32
          }
        },
        "operators": {
          "anyOf": [
            {
              "$ref": "#/$defs/Operators"
            },
            {
              "type": "null"
            }
          ]
        },
        "polarization": {
          "$ref": "#/$defs/Polarization",
          "default": "TM"
        },
        "results": {
          "$ref": "#/$defs/Results",
          "default": {
            "eigenvectors": false
          }
        },
        "schema": {
          "type": "string"
        },
        "sweeps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sweep"
          }
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "task",
        "geometry"
      ]
    },
    "ContinuationPolicy": {
      "type": "string",
      "enum": [
        "off",
        "first_point",
        "previous_geometry"
      ]
    },
    "DType": {
      "type": "string",
      "enum": [
        "float64",
        "complex128"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "span": {
          "description": "Half-open UTF-8 byte offsets in the original TOML document.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "Dielectric": {
      "type": "object",
      "properties": {
        "interface_tolerance": {
          "type": "number",
          "format": "double",
          "default": 0.000001
        },
        "mesh_size": {
          "type": "integer",
          "format": "uint",
          "default": 3,
          "minimum": 0
        },
        "smoothing": {
          "$ref": "#/$defs/Smoothing",
          "default": "analytic"
        },
        "source": {
          "$ref": "#/$defs/DielectricSource",
          "default": "geometry"
        }
      },
      "additionalProperties": false
    },
    "DielectricSource": {
      "type": "string",
      "enum": [
        "geometry",
        "external"
      ]
    },
    "Discretization": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fft_rectangle"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "angular_cutoff": {
              "description": "Cartesian angular cutoff in inverse reference length; no implicit 2*pi.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "metric_ball"
            },
            "max_allocation_rounds": {
              "type": "integer",
              "format": "uint",
              "default": 32,
              "minimum": 0
            },
            "max_coefficients": {
              "type": "integer",
              "format": "uint",
              "default": 4096,
              "minimum": 0
            },
            "max_dense_dimension": {
              "type": "integer",
              "format": "uint",
              "default": 512,
              "minimum": 0
            },
            "max_embedding_points": {
              "type": "integer",
              "format": "uint",
              "default": 1048576,
              "minimum": 0
            },
            "max_enumerated_indices": {
              "type": "integer",
              "format": "uint",
              "default": 4194304,
              "minimum": 0
            },
            "max_estimated_payload_bytes": {
              "description": "Numerical payload admission, not a process RSS limit.",
              "type": "integer",
              "format": "uint",
              "default": 536870912,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "angular_cutoff"
          ]
        }
      ]
    },
    "Eigensolver": {
      "type": "object",
      "properties": {
        "block_size": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "max_iterations": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "precision": {
          "$ref": "#/$defs/Precision",
          "default": "f64"
        },
        "tolerance": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "run_start"
            },
            "jobs": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "solves": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "event",
            "jobs",
            "solves"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "job_start"
            },
            "job": {
              "$ref": "#/$defs/PlannedJob"
            },
            "job_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "event",
            "job_index",
            "job"
          ]
        },
        {
          "type": "object",
          "properties": {
            "band_point": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BandPoint"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completed": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "converged": {
              "type": "boolean"
            },
            "event": {
              "type": "string",
              "const": "progress"
            },
            "iterations": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "job_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "sample_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "event",
            "job_index",
            "sample_index",
            "completed",
            "total",
            "iterations",
            "converged"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "result"
            },
            "result": {
              "$ref": "#/$defs/ResultRecord"
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/JobFailure"
            },
            "event": {
              "type": "string",
              "const": "job_failure"
            }
          },
          "required": [
            "event",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "completed": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "event": {
              "type": "string",
              "const": "terminal"
            },
            "failed": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "status": {
              "$ref": "#/$defs/RunStatus"
            }
          },
          "required": [
            "event",
            "status",
            "completed",
            "failed"
          ]
        }
      ]
    },
    "Geometry": {
      "type": "object",
      "properties": {
        "background_epsilon": {
          "type": "number",
          "format": "double",
          "default": 1
        },
        "lattice": {
          "$ref": "#/$defs/Lattice"
        },
        "objects": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Object"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "lattice"
      ]
    },
    "GeometryDonorSelection": {
      "type": "string",
      "enum": [
        "same_k",
        "previous_k",
        "screened"
      ]
    },
    "GeometryInterpolation": {
      "type": "string",
      "enum": [
        "cubic",
        "fourier"
      ]
    },
    "GeometryMethod": {
      "type": "string",
      "enum": [
        "cold",
        "copy",
        "metric",
        "secant",
        "history",
        "residual",
        "response",
        "tangent",
        "reduced_response"
      ]
    },
    "GeometryParameterOrder": {
      "type": "string",
      "enum": [
        "grouped",
        "serpentine"
      ]
    },
    "GeometryResponseBasis": {
      "type": "string",
      "enum": [
        "fourier",
        "history",
        "residual"
      ]
    },
    "GeometryResponseModel": {
      "description": "Reusable source response limits. These do not weaken final field accuracy.",
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/GeometryResponseBasis",
          "default": "fourier"
        },
        "columns": {
          "type": "integer",
          "format": "uint",
          "default": 8,
          "minimum": 0
        },
        "max_relative_residual": {
          "type": "number",
          "format": "double",
          "default": 0.1
        },
        "max_reuses": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "max_step": {
          "type": "number",
          "format": "double",
          "default": 4
        },
        "training_iterations": {
          "type": "integer",
          "format": "uint",
          "default": 128,
          "minimum": 0
        },
        "training_tolerance": {
          "type": "number",
          "format": "double",
          "default": 0.0001
        }
      },
      "additionalProperties": false
    },
    "GeometryScope": {
      "type": "string",
      "enum": [
        "gamma",
        "anchors",
        "path"
      ]
    },
    "GeometryTransport": {
      "description": "Optional periodic shape transport, composed as an independent target trial.",
      "type": "object",
      "properties": {
        "interpolation": {
          "$ref": "#/$defs/GeometryInterpolation",
          "default": "cubic"
        },
        "jacobian": {
          "type": "boolean",
          "default": false
        },
        "max_interpolation_terms": {
          "type": "integer",
          "format": "uint",
          "default": 32000000,
          "minimum": 0
        },
        "max_stretch": {
          "type": "number",
          "format": "double",
          "default": 2
        }
      },
      "additionalProperties": false
    },
    "GeometryWarmStart": {
      "description": "Bounded native history on a fixed physical grid and lattice.",
      "type": "object",
      "properties": {
        "anchors": {
          "type": "array",
          "default": [],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "donor_selection": {
          "$ref": "#/$defs/GeometryDonorSelection",
          "default": "same_k"
        },
        "guards": {
          "type": "integer",
          "format": "uint",
          "default": 2,
          "minimum": 0
        },
        "history": {
          "type": "integer",
          "format": "uint",
          "default": 2,
          "minimum": 0
        },
        "innovation_columns": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "innovation_relative_tolerance": {
          "type": "number",
          "format": "double",
          "default": 0.001
        },
        "max_cache_bytes": {
          "type": "integer",
          "format": "uint",
          "default": 67108864,
          "minimum": 0
        },
        "max_guards": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "max_predictor_columns": {
          "description": "Zero selects twice the retained positive window.",
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "max_preparation_bytes": {
          "type": "integer",
          "format": "uint",
          "default": 67108864,
          "minimum": 0
        },
        "method": {
          "$ref": "#/$defs/GeometryMethod",
          "default": "copy"
        },
        "model": {
          "$ref": "#/$defs/GeometryResponseModel",
          "default": {
            "basis": "fourier",
            "columns": 8,
            "max_relative_residual": 0.1,
            "max_reuses": 4,
            "max_step": 4,
            "training_iterations": 128,
            "training_tolerance": 0.0001
          }
        },
        "parameter_order": {
          "$ref": "#/$defs/GeometryParameterOrder",
          "default": "grouped"
        },
        "response_iterations": {
          "type": "integer",
          "format": "uint",
          "default": 2,
          "minimum": 0
        },
        "response_tolerance": {
          "type": "number",
          "format": "double",
          "default": 0.25
        },
        "retain_tm_actions": {
          "type": "boolean",
          "default": false
        },
        "scope": {
          "$ref": "#/$defs/GeometryScope",
          "default": "gamma"
        },
        "transport": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeometryTransport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Grid": {
      "type": "object",
      "properties": {
        "resolution": {
          "$ref": "#/$defs/Resolution",
          "default": 32
        }
      },
      "additionalProperties": false
    },
    "JobFailure": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "$ref": "#/$defs/Diagnostic"
        },
        "job_index": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "partial_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultRecord"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_index",
        "diagnostic"
      ]
    },
    "KCoordinates": {
      "type": "string",
      "enum": [
        "reciprocal_fractional",
        "cartesian_angular"
      ]
    },
    "KPath": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/KCoordinates",
          "default": "reciprocal_fractional"
        },
        "intervals_per_segment": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "points": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "vertices": {
          "type": [
            "array",
            "null"
          ],
