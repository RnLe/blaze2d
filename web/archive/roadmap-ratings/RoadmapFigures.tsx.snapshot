import type { ReactNode } from 'react';
import { ArrowDownRight, ChevronDown, FlaskConical, Layers3 } from 'lucide-react';
import { modules, stages, type ModuleId, type ModuleStatus } from './roadmap-data';

type Dimension = 'complexity' | 'scope';
const dimensions: Dimension[] = ['complexity', 'scope'];
const statusClasses: Record<ModuleStatus, string> = { Done: 'is-done', 'In Development': 'is-developing', Planned: 'is-planned' };

export function StatusLabel({ status }: { status: ModuleStatus }) {
  return <strong className={`roadmap-item-status ${statusClasses[status]}`}>{status}</strong>;
}

function FilledSymbol({ dimension, fraction }: { dimension: Dimension; fraction: number }) {
  const Icon = dimension === 'complexity' ? FlaskConical : Layers3;
  return <span className="roadmap-rating-symbol" aria-hidden="true" data-fill={fraction}>
    <Icon className="roadmap-rating-empty" />
    {fraction > 0 && <Icon className="roadmap-rating-fill" style={{ clipPath: `inset(${(1 - fraction) * 100}% 0 0)` }} />}
  </span>;
}

function RatingPair({ module, compact = false }: { module: ModuleId; compact?: boolean }) {
  const item = modules[module];
  return <span className={`roadmap-ratings${compact ? ' is-compact' : ''}`} data-ratings-for={module}>
    {dimensions.map(dimension => <span className="roadmap-rating" key={dimension} role="img"
      aria-label={`${dimension === 'complexity' ? 'Complexity' : 'Scope'}: ${item[dimension]} out of 5`} data-dimension={dimension} data-score={item[dimension]}>
      <span className="roadmap-rating-track">
        {compact ? <FilledSymbol dimension={dimension} fraction={item[dimension] / 5} /> :
          [4, 3, 2, 1, 0].map(level => <FilledSymbol key={level} dimension={dimension} fraction={Math.min(1, Math.max(0, item[dimension] - level))} />)}
      </span>
      <span className="roadmap-rating-number" aria-hidden="true">{item[dimension].toFixed(1)}</span>
    </span>)}
  </span>;
}

export function ModuleRatings({ module }: { module: ModuleId }) {
  const item = modules[module];
  return <details className="roadmap-rating-details">
    <summary aria-label={`Why ${item.title} is rated complexity ${item.complexity} and scope ${item.scope} out of 5`}>
      <RatingPair module={module} compact /><ChevronDown size={13} aria-hidden="true" />
    </summary>
    <div className="roadmap-rating-reasons">
      <p><strong>Complexity {item.complexity.toFixed(1)} / 5.</strong> {item.complexityReason}</p>
      <p><strong>Scope {item.scope.toFixed(1)} / 5.</strong> {item.scopeReason}</p>
    </div>
  </details>;
}

export function Motivation({ module, children }: { module: ModuleId; children?: ReactNode }) {
  return <aside className="roadmap-motivation" aria-label={`Motivation for ${modules[module].title}`}>
    <strong className="roadmap-motivation-label">Motivation</strong>
    <p>{children ?? modules[module].motivation}</p>
  </aside>;
}

export function DevelopmentSequence() {
  return <>
    <nav aria-label="Development stages" className="roadmap-stages">
      {stages.map(stage => <section className="roadmap-stage-card" data-stage={stage.number} key={stage.number}>
        <a className="roadmap-stage-heading" href={`#${stage.anchor}`}>
          <span className="roadmap-stage-label">Stage {stage.number}<ArrowDownRight size={18} aria-hidden="true" /></span>
          <h1>{stage.title}</h1>
          <span className="roadmap-stage-description">{stage.description}</span>
        </a>
        <div className="roadmap-stage-items">
          {stage.items.map(module => {
            const item = modules[module];
            return <a className="roadmap-stage-item" href={`#${item.anchor}`} key={module}>
              <div className="roadmap-item-copy">
                <h2>{item.title}</h2>
                <span className="roadmap-item-description">{item.description}</span>
                <StatusLabel status={item.status} />
              </div>
              <RatingPair module={module} />
            </a>;
          })}
        </div>
      </section>)}
    </nav>
    <div className="roadmap-sequence-caption">
      <div className="roadmap-rating-legend" aria-label="Complexity and scope legend">
        <span><FlaskConical size={17} aria-hidden="true" /><strong>Complexity</strong> Theory, curation, and validation.</span>
        <span><Layers3 size={17} aria-hidden="true" /><strong>Scope</strong> Time and total work volume.</span>
      </div>
      <p>Symbols fill from bottom to top: 0 to 5, in half steps. Relative estimates for the stated scope, including work already delivered. Select the ratings beside a section heading for the reasoning.</p>
      <p>The stages describe the intended order of development. <strong>Basic symmetries must be implemented and validated before GPU or 3D work begins.</strong></p>
    </div>
  </>;
}
