    }
  },
  "slack6-none": {
    "description": "Six extra block vectors and no history block",
    "binary": "current",
    "requires": "eigensolver.stopping, eigensolver.residual_tolerance and eigensolver.history",
    "bands": {
      "symmetry": {
        "arithmetic": "pt_real",
        "k_reuse": "identical"
      }
    },
    "eigensolver": {
      "stopping": "residual",
      "residual_tolerance": 1e-07,
      "max_iterations": 600,
      "history": "none",
      "block_size": 18
    }
  },
  "baseline-tight": {
    "description": "PT-real arithmetic with residual stopping at 1e-8 (lower edge of the automatic PT window)",
    "binary": "current",
    "requires": "eigensolver.stopping, eigensolver.residual_tolerance and eigensolver.history",
    "bands": {
      "symmetry": {
        "arithmetic": "pt_real",
        "k_reuse": "identical"
      }
    },
    "eigensolver": {
