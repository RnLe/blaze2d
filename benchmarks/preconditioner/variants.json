      "preconditioner": {
        "shift": "legacy",
        "shift_fraction": 0.5,
        "transverse_weight": "scalar"
      }
    }
  },
  "default": {
    "description": "Built-in defaults of the current binary (residual stopping and automatic PT on native f64)",
    "binary": "current"
  },
