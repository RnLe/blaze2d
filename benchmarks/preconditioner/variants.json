{
  "frozen-legacy": {
    "description": "Current defaults: manual symmetry, eigenvalue-change tolerance 1e-6, max_iterations 200",
    "binary": "frozen"
  },
  "frozen-pt-tight": {
    "description": "Frozen binary with PT-real arithmetic forced and a tight eigenvalue-change stop",
    "binary": "frozen",
    "bands": {
      "symmetry": {
        "arithmetic": "pt_real",
        "k_reuse": "identical"
      }
    },
    "eigensolver": {
      "tolerance": 1e-13,
      "max_iterations": 600
    }
  },
  "baseline": {
    "description": "PT-real arithmetic with residual stopping at 1e-7 and Ritz history; new binary only",
    "binary": "current",
    "requires": "eigensolver.preconditioner.transverse_weight (binaries after 56617e9d; earlier ones reject the key)",
    "bands": {
      "symmetry": {
        "arithmetic": "pt_real",
        "k_reuse": "identical"
      }
    },
    "eigensolver": {
      "stopping": "residual",
      "residual_tolerance": 1e-07,
      "max_iterations": 600,
      "history": "ritz",
      "preconditioner": {
        "shift": "legacy",
        "shift_fraction": 0.5,
        "transverse_weight": "scalar"
      }
    }
  },
