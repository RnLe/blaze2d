    "requires": "eigensolver.stopping, eigensolver.residual_tolerance and eigensolver.history",
    "bands": {
      "symmetry": {
        "arithmetic": "spatial_complex",
        "k_reuse": "identical"
      }
    },
    "eigensolver": {
      "stopping": "residual",
      "residual_tolerance": 1e-08,
      "max_iterations": 600,
      "history": "ritz"
    }
  }
